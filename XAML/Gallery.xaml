<Window x:Class="MonsterEnergyCollectionApp.Gallery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonsterEnergyCollectionApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="Галерея монстров"
        Height="1000"
        Width="800">

    <Grid Background="#0D0D0D">

        <Grid.Resources>

            <Style TargetType="Button">
                <Setter Property="Background" Value="#191919"/>
                <Setter Property="Foreground" Value="#E5E7EB"/>
                <Setter Property="BorderBrush" Value="#303030"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#252525"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#444444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#101010"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стили для кнопок-повторителей (чтобы клик по пустой дорожке прокручивал страницу) -->
            <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль для самого ползунка (Бегунка) -->
            <Style x:Key="DarkScrollThumb" TargetType="Thumb">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <!-- Фиксируем отступы Margin, чтобы бегунок не сжимался системой -->
                            <Border x:Name="Rectangle"
                        Background="#4E4E4E"
                        CornerRadius="4"
                        Margin="2,0" />
                            <ControlTemplate.Triggers>
                                <!-- Подсветка при наведении -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rectangle" Property="Background" Value="#6E6E6E" />
                                </Trigger>
                                <!-- Подсветка при перетаскивании -->
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Rectangle" Property="Background" Value="#8E8E8E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Полный сброс и стилизация ScrollBar -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="#1E1E1E" />
                <!-- Темный фон дорожки -->
                <Setter Property="Foreground" Value="Transparent" />
                <Setter Property="Width" Value="10" />
                <!-- Фиксированная ширина -->
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="0" />
                                    <!-- Полностью скрываем системные стрелочки -->
                                    <RowDefinition Height="0.00001*" />
                                    <RowDefinition MaxHeight="0" />
                                </Grid.RowDefinitions>

                                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DarkScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!-- Триггер для горизонтального скроллбара (меняем ширину на высоту) -->
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="10" />
                        <Setter Property="MinHeight" Value="10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="0" />
                                            <ColumnDefinition Width="0.00001*" />
                                            <ColumnDefinition MaxWidth="0" />
                                        </Grid.ColumnDefinitions>
                                        <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False" IsEnabled="{TemplateBinding IsEnabled}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <!-- Для горизонтального скролла делаем отступы сверху и снизу -->
                                                <Thumb Style="{StaticResource DarkScrollThumb}">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="Rectangle" Background="#4E4E4E" CornerRadius="4" Margin="0,2" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Rectangle" Property="Background" Value="#6E6E6E" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageRightCommand}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#151515"
                BorderBrush="#292929"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="40"
                        Width="90"
                        Content="←  Назад"
                        Background="#191919"
                        Foreground="White"
                        BorderBrush="#303030"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="GoBack_Click"/>

                <Button Grid.Column="1"
                        Height="40"
                        Width="40"
                        Margin="5, 0, 0, 0"
                        Content="↻"
                        Background="#191919"
                        Foreground="White"
                        BorderBrush="#303030"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ReloadBtn_Click"/>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="25,0,0,0">

                    <TextBlock Text="ГАЛЕРЕЯ МОНСТРОВ"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                </StackPanel>

                <Border Grid.Column="3"
                        Background="#163326"
                        CornerRadius="10"
                        Padding="14,7"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <!-- Новая ячейка (текст) слева от количества -->
                        <TextBlock x:Name="MonstersPricesValue"
                                   Text="0 ₽"
                                   Foreground="#10B981"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="●"
                                   Foreground="#10B981"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>

                        <TextBlock x:Name="MonstersCountValue"
                                   Text="0 шт"
                                   Foreground="#10B981"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <ListBox Grid.Row="1"
                 x:Name="MonstersListBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="21,14"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:MonsterCard/>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>

    </Grid>


</Window>
