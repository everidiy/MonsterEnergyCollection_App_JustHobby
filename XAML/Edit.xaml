<Window x:Class="MonsterEnergyCollectionApp.Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonsterEnergyCollectionApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="Изменение данных" Height="680" Width="800">

    <Window.Resources>

        <!-- TEXTBOX -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#10B981"/>
            <Setter Property="SelectionBrush" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                Property="BorderBrush"
                                Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                Property="BorderBrush"
                                Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#101010"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="#252525"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="#163326"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBorder"
                            Background="#101010"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="White"/>

                                <ToggleButton Grid.Column="1"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0">
                                    <TextBlock Text="⌄"
                                       Foreground="#10B981"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Background="#101010"
                                BorderBrush="#303030"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                MaxHeight="240">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATEPICKER -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                       Grid.Column="0"
                                       Background="#101010"
                                       Foreground="White"
                                       BorderBrush="#303030"
                                       BorderThickness="1"
                                       Padding="8,0"
                                       VerticalContentAlignment="Center"/>

                            <Button x:Name="PART_Button"
                            Grid.Column="1"
                            Content="▦"
                            FontSize="15"
                            Foreground="#10B981"
                            Background="#191919"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            Margin="4,0,0,0"
                            Padding="0"/>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#151515"
                                BorderBrush="#303030"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                                    <Calendar x:Name="PART_Calendar"
                                      Background="#151515"
                                      Foreground="White"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BUTTONS -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#252525"/>
                                <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#0D0D0D">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
            Background="#151515"
            BorderBrush="#292929"
            BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="ИЗМЕНЕНИЕ ДАННЫХ"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Row="1"
          Margin="28">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>


            <!-- IMAGE -->

            <Button Grid.Column="0"
                    Margin="0,0,15,0"
                    Click="EditImageButton_Click"
                    x:Name="EditImageBtn">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- Внешняя рамка кнопки (на весь доступный размер) -->
                        <Border Background="#151515"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    CornerRadius="12">

                            <Grid>
                                <!-- Внутренний контейнер для картинки. 
                         Убрали фиксированные 180х180.
                         Добавили Margin="12" для легкого паддинга от краев кнопки. -->
                                <Border Margin="12" 
                            Background="#101010"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="12"
                            ClipToBounds="True">
                                    <Grid>
                                        <!-- Картинка теперь растянется на всю область этого Border -->
                                        <Image x:Name="SelectedMonsterImage" 
                                   Stretch="UniformToFill"/>

                                        <!-- Текст и плюс по центру -->
                                        <StackPanel x:Name="UploadPrompt" 
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                            <TextBlock Text="＋"
                                           Foreground="#10B981"
                                           FontSize="42"
                                           HorizontalAlignment="Center"/>
                                            <TextBlock Text="Добавить изображение"
                                           Foreground="#B0B0B0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                                            <TextBlock Text="PNG, JPG или HEIC"
                                           Foreground="#777777"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>




            <!-- FORM -->

            <Border Grid.Column="1"
                Background="#151515"
                BorderBrush="#292929"
                BorderThickness="1"
                CornerRadius="14"
                Padding="28">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ"
                               Foreground="#10B981"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>


                        <!-- NAME -->

                        <TextBlock Text="Название (Писать Monster Energy (Тип) не нужно)"
                               Foreground="#B0B0B0"
                               FontSize="11"
                               Margin="0,0,0,7"/>

                        <TextBox Height="40"
                                 x:Name="EditNameValue"
                             Background="#101010"
                             Foreground="White"
                             BorderBrush="#303030"
                             BorderThickness="1"
                             FontSize="13"
                             Padding="12,0"
                             Margin="0,0,0,16"/>


                        <!-- TYPE + LEVEL -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="Тип"
                                       Foreground="#B0B0B0"
                                       FontSize="11"
                                       Margin="0,0,0,7"/>

                                <ComboBox Height="40"
                                          x:Name="EditTypesValue"
                                      Background="#101010"
                                      Foreground="#101010"
                                      BorderBrush="#303030"
                                      FontSize="12">

                                    <ComboBoxItem Content="Ultra"/>
                                    <ComboBoxItem Content="Classic"/>
                                    <ComboBoxItem Content="Nitro"/>
                                    <ComboBoxItem Content="Juiced"/>
                                    <ComboBoxItem Content="Punch"/>
                                    <ComboBoxItem Content="VR46"/>
                                    <ComboBoxItem Content="Reserved"/>

                                </ComboBox>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Цена"
                                       Foreground="#B0B0B0"
                                       FontSize="11"
                                       Margin="0,0,0,7"/>

                                <TextBox Height="40"
                                         x:Name="EditPriceValue"
                                     Background="#101010"
                                     Foreground="White"
                                     BorderBrush="#303030"
                                     FontSize="13"
                                     Padding="12,0"/>

                            </StackPanel>

                        </Grid>

                        <!-- ENERGY -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="Памятка по оценкам вкуса"
                                           Foreground="#B0B0B0"
                                           FontSize="11"
                                           Margin="0,0,0,7"/>

                                <Border Background="#101010" 
                                        BorderBrush="#303030" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="14,12">
                                    <StackPanel>

                                        <TextBlock Foreground="#B0B0B0" FontSize="12" Margin="0,3">
                                            <Run Text="• Вкусный:" Foreground="#777777"/> 
                                            <Run Text=" 8 - 10 баллов" Foreground="#10B981" FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <TextBlock Foreground="#B0B0B0" FontSize="12" Margin="0,3">
                                            <Run Text="• Обычный:" Foreground="#777777"/> 
                                            <Run Text=" 5 - 7 баллов" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <TextBlock Foreground="#B0B0B0" FontSize="12" Margin="0,3">
                                            <Run Text="• Ужасный:" Foreground="#777777"/> 
                                            <Run Text=" 1 - 4 балла" Foreground="#EF4444" FontWeight="SemiBold"/>
                                        </TextBlock>

                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Дата покупки"
                                           Foreground="#B0B0B0"
                                           FontSize="11"
                                           Margin="0,16,0,7"/>

                                <DatePicker x:Name="EditMonsterDateValue"
                                            Height="25"
                                            Background="#101010"
                                            Foreground="#101010"
                                            BorderBrush="#303030"
                                            FontSize="12"/>

                            </StackPanel>




                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Оценка"
                                       Foreground="#B0B0B0"
                                       FontSize="11"
                                       Margin="0,0,0,7"/>

                                <ComboBox Height="40"
                                          x:Name="EditMarksValue"
                                          Background="#101010"
                                          Foreground="#101010"
                                          BorderBrush="#303030"
                                          FontSize="12">

                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>

                                </ComboBox>

                                <TextBlock Text="Дизайн"
                                           Foreground="#B0B0B0"
                                           FontSize="11"
                                           Margin="0,15,0,7"/>

                                <ComboBox Height="40"
                                          x:Name="EditDesignValue"
                                          Background="#101010"
                                          Foreground="#101010"
                                          BorderBrush="#303030"
                                          FontSize="12">

                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>

                                </ComboBox>
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- FOOTER -->

        <Border Grid.Row="2"
            Background="#151515"
            BorderBrush="#292929"
            BorderThickness="0,1,0,0">

            <Grid Margin="28,0">

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <Button Content="Отмена"
                        Width="110"
                        Height="40"
                        Background="#202020"
                        Foreground="#B0B0B0"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        FontSize="12"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Click="GoBack_Click"/>

                    <Button Content="Сохранить изменения"
                        Width="160"
                        Height="40"
                        Background="#10B981"
                        Foreground="#07130F"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="SaveChanges_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>
