<UserControl x:Class="MonsterEnergyCollectionApp.MonsterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MonsterEnergyCollectionApp"
             mc:Ignorable="d"
             Width="250"
             Height="550"
             d:DataContext="{d:DesignInstance Type=local:Monster, IsDesignTimeCreatable=True}">

    <UserControl.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252525"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#10B981"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#101010"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Border Background="#151515"
            BorderBrush="#292929"
            BorderThickness="1"
            CornerRadius="15"
            Margin="7">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Изображение -->
            <Border Grid.Row="0"
                    Background="#0D0D0D"
                    CornerRadius="14,14,0,0"
                    ClipToBounds="True">

                <Grid>
                    <Image Source="{Binding Image, IsAsync=True}"
                           Stretch="Uniform"
                           Margin="10,8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <Border VerticalAlignment="Top"
                            Padding="11,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1"
                                    Background="#252525"
                                    BorderBrush="#3A3A3A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3">
                                <TextBlock
                                    Text="{Binding Number, StringFormat={}{0:#}}"
                                    Foreground="White"
                                    FontSize="10"
                                    FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Height="2"
                            Background="#10B981"
                            Opacity="0.8"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Информация -->
            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- Название: максимум две строки -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Name}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Height="36"
                               MaxHeight="36"
                               ToolTip="{Binding Name}"/>

                    <TextBlock Text="{Binding Type, StringFormat=Тип: {0}, TargetNullValue=Тип: —}"
                               Foreground="#777777"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Цена -->
                <Border Grid.Row="1"
                        Background="#10231C"
                        BorderBrush="#194A36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,7,0,9">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Стоимость"
                                   Foreground="#8A9B91"
                                   FontSize="9"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Price, StringFormat={}{0:F0} ₽}"
                                   Foreground="#10B981"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Вкус и дизайн -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
               Text="Вкус:"
               Style="{StaticResource InfoLabel}"
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

                    <TextBlock Grid.Column="1"
               Text="{Binding Taste, TargetNullValue=—}"
               Style="{StaticResource InfoValue}"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="2"
               Text="Дизайн:"
               Style="{StaticResource InfoLabel}"
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

                    <TextBlock Grid.Column="3"
               Text="{Binding Design, TargetNullValue=—}"
               Style="{StaticResource InfoValue}"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center"/>
                </Grid>

                <!-- Оценка и дата -->
                <StackPanel Grid.Row="3"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20">

                    <Border Background="#202020"
                            CornerRadius="8"
                            Padding="10,7">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Оценка"
                                       Foreground="#999999"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{Binding Mark}"
                                           Foreground="#10B981"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock Text=" / 10"
                                           Foreground="#777777"
                                           FontSize="10"
                                           VerticalAlignment="Bottom"
                                           Margin="2,0,0,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Date, StringFormat=Добавлен: {0}, TargetNullValue=Добавлен: —}"
                               Foreground="#666666"
                               FontSize="9"
                               Margin="2,7,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Date}"/>
                </StackPanel>

                <!-- Кнопка -->
                <Button Grid.Row="4"
                        Content="Изменить карточку  →"
                        Height="34"
                        Background="#191919"
                        Foreground="#E5E7EB"
                        BorderBrush="#303030"
                        FontWeight="SemiBold"
                        Click="EditBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>