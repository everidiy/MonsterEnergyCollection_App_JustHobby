<Window x:Class="MonsterEnergyCollectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonsterEnergyCollectionApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="Главное меню" Height="700" Width="950"
        Background="#0D0D0D">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252525"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0D0D0D">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#151515" BorderBrush="#292929" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <TextBlock Text="ПЕРСОНАЛЬНАЯ КОЛЛЕКЦИЯ МОНСТРОВ"
                           Foreground="#FFFFFF"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT MENU -->
            <StackPanel Grid.Column="0"
            Margin="0,0,24,0">

                <!-- MENU TITLE -->
                <TextBlock Text="МЕНЮ"
               Foreground="#888888"
               FontSize="11"
               FontWeight="Bold"
               HorizontalAlignment="Left"
               Margin="4,4,0,16"/>

                <!-- ADD BUTTON -->
                <Button Height="58"
            Margin="0,0,0,10"
            Padding="0"
            Background="#191919"
            BorderBrush="#292929"
            BorderThickness="1"
            Click="AddBtn_Click">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                       Text="+"
                       FontSize="27"
                       FontWeight="Light"
                       Foreground="#10B981"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                            <TextBlock Text="Добавить"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                            <TextBlock Text="Добавить новую запись"
                           FontSize="10"
                           Foreground="#777777"
                           Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- GALLERY BUTTON -->
                <Button Height="58"
            Margin="0,0,0,10"
            Padding="0"
            Background="#191919"
            BorderBrush="#292929"
            BorderThickness="1"
            Click="GalleryBtn_Click">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                       Text="▦"
                       FontSize="21"
                       Foreground="#B0B0B0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                            <TextBlock Text="Галерея"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                            <TextBlock Text="Все собранные монстры"
                           FontSize="10"
                           Foreground="#777777"
                           Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- RELOAD BUTTON -->
                <Button Height="58"
            Margin="0,0,0,10"
            Padding="0"
            Background="#191919"
            BorderBrush="#292929"
            BorderThickness="1"
            Click="ReloadBtn_Click">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                       Text="↻"
                       FontSize="22"
                       Foreground="#B0B0B0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                            <TextBlock Text="Обновить"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                            <TextBlock Text="Перезагрузить список"
                           FontSize="10"
                           Foreground="#777777"
                           Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- RATING BUTTON -->
                <Button Height="58"
            Margin="0,0,0,24"
            Padding="0"
            Background="#191919"
            BorderBrush="#292929"
            BorderThickness="1"
            Click="RatingBtn_Click">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                       Text="★"
                       FontSize="20"
                       Foreground="#10B981"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                            <TextBlock Text="Рейтинг"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                            <TextBlock Text="Просмотреть таблицу"
                           FontSize="10"
                           Foreground="#777777"
                           Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- COLLECTION STATISTICS -->
                <Border Background="#151515"
            BorderBrush="#292929"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">

                    <StackPanel>

                        <!-- HEADER -->
                        <TextBlock Text="КОЛЛЕКЦИЯ"
                       Foreground="#888888"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

                        <!-- TOTAL COUNT -->
                        <TextBlock Text="0"
                       x:Name="MonsterVault_Main"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       Margin="0,0,0,0"/>

                        <TextBlock Text="напитков собрано"
                       Foreground="#777777"
                       FontSize="11"
                       Margin="0,-2,0,0"/>

                        <!-- DIVIDER -->
                        <Border Height="1"
                    Background="#292929"
                    Margin="0,16,0,14"/>

                        <!-- TASTE STATISTICS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TASTY -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Вкусные"
                               Foreground="#888888"
                               FontSize="10"
                               Margin="0,0,0,4"/>

                                <TextBlock Text="0"
                               x:Name="TastyMonsters_Count"
                               Foreground="#10B981"
                               FontSize="22"
                               FontWeight="Bold"/>
                            </StackPanel>

                            <!-- NORMAL -->
                            <StackPanel Grid.Column="1"
                            Margin="4,0,0,0">
                                <TextBlock Text="Обычные"
                               Foreground="#888888"
                               FontSize="10"
                               Margin="0,0,0,4"/>

                                <TextBlock Text="0"
                               x:Name="SimpleMonsters_Count"
                               Foreground="#FBBF24"
                               FontSize="22"
                               FontWeight="Bold"/>
                            </StackPanel>

                            <!-- BAD -->
                            <StackPanel Grid.Column="2"
                            Margin="4,0,0,0">
                                <TextBlock Text="Ужасные"
                               Foreground="#888888"
                               FontSize="10"
                               Margin="0,0,0,4"/>

                                <TextBlock Text="0"
                               x:Name="YukkyMonsters_Count"
                               Foreground="#EF4444"
                               FontSize="22"
                               FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Последний выбор" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Последний обнаруженный напиток" Foreground="#777777" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- MONSTER CARD -->
                <Border Grid.Row="1" Background="#151515" BorderBrush="#292929" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="18" CornerRadius="12" Background="#101010" BorderBrush="#292929" BorderThickness="1">
                            <Grid>
                                <Image x:Name="LastMonsterImage" Stretch="UniformToFill"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="👾" x:Name="TestImg" FontSize="90" HorizontalAlignment="Center"/>
                                    <TextBlock Text="MONSTER #000" x:Name="ImageNumber_Value" Foreground="#777777" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="15,30,25,25">
                            <TextBlock Text="ПОСЛЕДНИЙ МОНСТР" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Monster Energy Ultra Bad Apple"
                                       x:Name="LastMonsterName_Value"
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,25,0,18"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Text="ULTRA" x:Name="LastMonsterType_Value" Foreground="#B0B0B0" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#163326" BorderBrush="#24523D" BorderThickness="1" CornerRadius="7" Padding="10,5">
                                    <TextBlock Text="ВКУСНЫЙ" x:Name="LastMonsterTaste_Value" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,0,0,22">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="1" Text="Цена" Foreground="#777777" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="450 ₽" x:Name="LastMonsterPrice_Value" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Оценка" Foreground="#777777" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="7 / 10" x:Name="LastMonsterMark_Value" Foreground="#E5E5E5" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Text="Дизайн" Foreground="#777777" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="7 / 10" x:Name="LastMonsterDesign_Value" Foreground="#E5E5E5" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Text="Дата покупки" Foreground="#777777" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="01.01.2026" x:Name="LastMonsterDate_Value" Foreground="#E5E5E5" FontSize="12" Margin="0,10,0,0"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Открыть галерею" Width="145" Height="40" Background="#191919" Foreground="#E5E5E5" BorderBrush="#303030" FontWeight="SemiBold" Click="GalleryBtn_Click"/>
                                <Button Content="Изменить данные" Width="145" Height="40" Background="#191919" Foreground="#E5E5E5" BorderBrush="#303030" FontWeight="SemiBold" Margin="8,0,0,0" Click="EditBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
